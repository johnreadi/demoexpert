{
  "name": "demoexpert",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node inject-timestamp.js",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview:prod": "vite preview --port 4173",
    "docker:build": "docker build -f Dockerfile.web -t demoexpert-frontend .",
    "docker:run": "docker run -p 8080:80 demoexpert-frontend",
    "docker:deploy": "npm run docker:build && npm run docker:run",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "git:add": "git add -A",
    "git:commit": "git commit -m \"auto: push\"",
    "git:push:Main": "git push origin Main",
    "git:auto": "npm run git:add && npm run git:commit && npm run git:push:Main",
    "git:push:auto": "node -e \"const { execSync } = require('child_process'); let branch = 'Main'; try { branch = execSync('git rev-parse --abbrev-ref HEAD').toString().trim() || branch; } catch(e) {} execSync('git add -A'); try { execSync('git commit -m \\\"auto: push\\\"'); } catch(e) {} execSync('git push origin ' + branch, { stdio: 'inherit' });\"",
    "postinstall": "echo '✅ Dépendances installées. Utilisez npm run dev pour démarrer.'"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "lucide-react": "^0.468.0",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^7.1.7",
    "prisma": "5.22.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "frontend",
    "automobile",
    "demoexpert"
  ],
  "author": "DemoExpert",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnreadi/demoexpert.git"
  },
  "bugs": {
    "url": "https://github.com/johnreadi/demoexpert/issues"
  },
  "homepage": "https://app.demoexpert.fr",
  "cacheDirectories": [
    "node_modules",
    ".vite"
  ]
}
