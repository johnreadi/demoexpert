# ============================================
# Démolition Expert - Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# --------------------------------------------
# Base de données (obligatoire)
# --------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database
DB_HOST=demoexpert-expertdb-djopvt-kgplzz
DB_NAME=demoexpert-expertdb-djopvt

# --------------------------------------------
# Sécurité (obligatoire en production)
# --------------------------------------------
# Générez avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=votre_secret_aleatoire_64_caracteres_minimum

# Clé pour chiffrer les données sensibles (SMTP, etc.)
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=votre_cle_de_chiffrement_32_caracteres

# --------------------------------------------
# Configuration admin par défaut
# --------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@demoexpert.fr
DEFAULT_ADMIN_PASSWORD=mot_de_passe_fort_a_changer

# --------------------------------------------
# Configuration CORS
# --------------------------------------------
CORS_ORIGIN=https://app.demoexpert.fr

# --------------------------------------------
# Configuration SMTP (optionnel)
# --------------------------------------------
SMTP_HOST=smtp.votre-fai.fr
SMTP_PORT=587
SMTP_USER=votre-email@domaine.fr
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM_NAME=Démolition Expert
SMTP_FROM_EMAIL=no-reply@demoexpert.fr

# --------------------------------------------
# Configuration Gemini AI (optionnel)
# --------------------------------------------
GEMINI_API_KEY=votre_cle_api_gemini

# --------------------------------------------
# Réseau Docker (Dokploy)
# --------------------------------------------
TRAEFIK_DOCKER_NETWORK=dokploy-network

# --------------------------------------------
# Mode strict (désactive les fallbacks mock)
# --------------------------------------------
STRICT_DB=false
SEED_DB=true
