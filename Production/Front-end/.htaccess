# Configuration .htaccess optimisée pour o2Switch
# Démolition Expert - Application Node.js

# Activer le module rewrite
RewriteEngine On

# Headers de sécurité
<IfModule mod_headers.c>
    # Sécurité de base
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"

    # Cache pour les assets statiques
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Expires "Thu, 31 Dec 2025 23:59:59 GMT"
    </FilesMatch>

    # Cache pour HTML (court)
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Pas de cache pour API
    <Location "/api/">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Location>
</IfModule>

# Protection des fichiers sensibles
<FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protection du fichier .env
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# Redirection HTTP vers HTTPS (si SSL activé)
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Configuration MIME types
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Configuration du cache navigateur
<IfModule mod_expires.c>
    ExpiresActive On

    # Assets statiques - 1 an
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # HTML - 1 heure
    ExpiresByType text/html "access plus 1 hour"

    # API - pas de cache
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Configuration pour React Router (SPA)
<IfModule mod_rewrite.c>
    # Rediriger toutes les requêtes vers index.html sauf les assets et API
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule . /index.html [L]
</IfModule>

# Optimisations PHP (si utilisé pour certains endpoints)
<IfModule mod_php.c>
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>

# Logs d'erreur (optionnel - décommenter si besoin)
# ErrorLog logs/error.log
# LogLevel warn

# Configuration spécifique o2Switch
# Si vous avez des problèmes de mémoire, ajustez ces valeurs
<IfModule mod_fcgid.c>
    FcgidMaxRequestLen 1073741824
    FcgidConnectTimeout 300
</IfModule>

# Protection contre les hotlinks (optionnel)
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?votre-domaine\.com [NC]
# RewriteCond %{HTTP_REFERER} !^$
# RewriteRule \.(gif|jpg|jpeg|png|svg)$ - [F,L]

# Configuration pour les websockets (si utilisé)
# RewriteCond %{HTTP:UPGRADE} ^WebSocket$ [NC]
# RewriteCond %{HTTP:CONNECTION} ^Upgrade$ [NC]
# RewriteRule .* ws://localhost:3001%{REQUEST_URI} [P,L]

# Fin du fichier .htaccess
