# Configuration de production - Démolition Expert
NODE_ENV=production
PORT=3001

# Base de données o2Switch
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demolition_expert
DB_USER=demolition_user
DB_PASSWORD=your_mysql_password_here

# JWT
JWT_SECRET=your_jwt_secret_32_chars_minimum_change_this
JWT_EXPIRES_IN=24h

# CORS - Adaptez selon votre domaine
FRONTEND_URL=https://your-domain.com

# EMAIL - Configuration PHP native (o2Switch)
EMAIL_METHOD=php_native
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Démolition Expert
EMAIL_REPLY_TO=contact@your-domain.com

# Configuration o2Switch
CPANEL_USER=your-cpanel-username
CPANEL_DOMAIN=your-domain.com

# Optimisations pour l'environnement mutualisé
NODE_OPTIONS=--max-old-space-size=256
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=50
