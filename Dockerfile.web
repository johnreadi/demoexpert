FROM node:20-alpine AS build
WORKDIR /app

# Variables pour le build
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_BASE_URL=https://app.demoexpert.fr
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_BASE_URL=$VITE_APP_BASE_URL
ENV NODE_ENV=production

# Copier les fichiers
COPY package.json package-lock.json* ./
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY index.html ./
COPY src/ ./src/
COPY public/ ./public/
COPY postbuild.js ./

# Installer et builder
RUN npm ci --no-fund --no-audit
RUN npm run build

# ================= ÉTAPE NGINX =================
FROM nginx:1.27-alpine

# Copier le build React
COPY --from=build /app/dist /usr/share/nginx/html

# Copier la configuration nginx ANTI-CACHE
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Script pour forcer le non-cache
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Fichier de santé
RUN echo "OK" > /usr/share/nginx/html/health.txt

EXPOSE 80

# Health check pour Dokploy
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health.txt || exit 1

# Point d'entrée avec cache busting
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
