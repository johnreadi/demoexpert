# ================= ÉTAPE DE BUILD =================
FROM node:20-alpine AS build
WORKDIR /app

# Variables pour le build
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_BASE_URL=https://app.demoexpert.fr
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_BASE_URL=$VITE_APP_BASE_URL
ENV NODE_ENV=production

# 1. Copier les fichiers de package d'abord (cache layer)
COPY package.json package-lock.json ./

# 2. Installer TOUTES les dépendances (dev incluses pour le build)
RUN npm ci --no-fund --no-audit --include=dev

# 3. Copier TOUS les autres fichiers
COPY . .

# 4. Builder l'application
RUN npm run build

# 5. Post-build: cache busting
RUN echo "🔧 Applying cache busting..." && \
    # Créer version.json
    echo '{"buildTimestamp":"'$(date +%s)'","date":"'$(date -Iseconds)'","cache":"disabled"}' > dist/version.json && \
    # Injecter meta tags dans index.html
    sed -i '/<head>/a\
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">\
    <meta http-equiv="Pragma" content="no-cache">\
    <meta http-equiv="Expires" content="0">' dist/index.html && \
    echo "✅ Cache busting done"

# ================= ÉTAPE NGINX =================
FROM nginx:1.27-alpine

# Copier le build React
COPY --from=build /app/dist /usr/share/nginx/html

# Copier la configuration nginx ANTI-CACHE
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Fichier de santé pour Dokploy
RUN echo "healthy" > /usr/share/nginx/html/health.txt

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health.txt || exit 1

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
