# ================= ÉTAPE DE BUILD =================
# Build timestamp: 2025-03-08 - Force rebuild for SMTP test feature
FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copier les fichiers de package
COPY package.json package-lock.json ./

# 2. Installer TOUTES les dépendances (y compris dev pour le build)
RUN npm install --no-fund --no-audit

# 3. Copier le code source
COPY . .

# 4. Variables d'environnement pour le build
ARG VITE_API_BASE_URL=https://api.demoexpert.fr/api
ARG VITE_APP_BASE_URL=https://app.demoexpert.fr
ARG VITE_USE_LOCAL_API=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_BASE_URL=$VITE_APP_BASE_URL
ENV VITE_USE_LOCAL_API=$VITE_USE_LOCAL_API

# 5. Builder l'application
RUN npm run build

# 6. Vérifier que le build a réussi
RUN test -f dist/index.html || (echo "BUILD FAILED: dist/index.html not found" && exit 1)

# 7. Post-build
RUN TIMESTAMP=$(date +%s) && \
    echo "$TIMESTAMP" > dist/build.timestamp && \
    echo "healthy" > dist/health.txt

# ================= ÉTAPE NGINX =================
FROM nginx:1.27-alpine

# Copier le build React
COPY --from=builder /app/dist /usr/share/nginx/html

# Copier la configuration nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN apk add --no-cache wget

EXPOSE 80

# Health check simple
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health.txt || exit 1

CMD ["nginx", "-g", "daemon off;"]
