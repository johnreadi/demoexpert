# Build sans Tailwind (si vraiment ça ne marche pas)
FROM node:20-alpine AS builder
WORKDIR /app

# Copier package.json
COPY package.json package-lock.json ./

# Installer SANS tailwind
RUN npm install --no-fund --no-audit --omit=dev

# Copier le code
COPY . .

# Supprimer les références à Tailwind pour éviter l'erreur
RUN rm -f postcss.config.js tailwind.config.js 2>/dev/null || true

# Variables
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_BASE_URL=https://app.demoexpert.fr
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_BASE_URL=$VITE_APP_BASE_URL

# Build
RUN npm run build

# Nginx
FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
